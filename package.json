{
    "name":  "bluemap",
    "private":  true,
    "version":  "0.1.0",
    "type":  "module",
    "engines":  {
                    "node":  "\u003e=20.19"
                },
    "scripts":  {
                    "dev":  "vite",
                    "build":  "vite build",
                    "preview":  "vite preview",
                    "typecheck":  "tsc --noEmit",
                    "test":  "vitest run",
                    "test:e2e":  "playwright test",
                    "electron:dev":  "concurrently -k \"npm run dev\" \"wait-on http://localhost:5178 \u0026\u0026 cross-env VITE_DEV_SERVER_URL=http://localhost:5178 node electron/dev-launch.cjs\"",
                    "electron:smoke":  "npm run build \u0026\u0026 electron --no-sandbox --disable-gpu electron/smoke-main.cjs",
                    "electron:start":  "npm run build \u0026\u0026 node electron/dev-launch.cjs",
                    "package:win":  "npm run build \u0026\u0026 node scripts/pack.cjs"
                },
    "dependencies":  {
                         "@ai-sdk/openai":  "^4.0.115",
                         "@ant-design/icons":  "^6.3.4",
                         "@dagrejs/dagre":  "^3.1.3",
                         "@xyflow/react":  "^12.12.1",
                         "ai":  "^7.0.170",
                         "antd":  "^6.7.0",
                         "cmdk":  "^1.1.1",
                         "dayjs":  "^1.11.23",
                         "dexie":  "^4.4.7",
                         "dexie-react-hooks":  "^4.4.0",
                         "immer":  "^11.2.10",
                         "react":  "^19.3.1",
                         "react-dom":  "^19.3.1",
                         "react-hotkeys-hook":  "^5.4.0",
                         "zod":  "^4.6.7",
                         "zundo":  "^2.3.0",
                         "zustand":  "^5.1.0"
                     },
    "devDependencies":  {
                            "@biomejs/biome":  "^2.6.7",
                            "@electron/packager":  "^18.4.4",
                            "@playwright/test":  "^1.65.0",
                            "@types/react":  "^19.3.0",
                            "@types/react-dom":  "^19.3.0",
                            "@vitejs/plugin-react":  "^6.3.0",
                            "concurrently":  "^9.2.5",
                            "cross-env":  "^10.1.0",
                            "electron":  "^41.7.1",
                            "typescript":  "^7.0.2",
                            "vite":  "^8.3.8",
                            "vitest":  "^5.1.0",
                            "wait-on":  "^9.5.1"
                        },
    "main":  "electron/main.cjs"
}
